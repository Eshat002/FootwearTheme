<section class="password-page">
  <div class="page-width">
    <div class="password-wrapper">
      {% if section.settings.logo != blank %}
        <div class="password-logo">
          {{ section.settings.logo | image_url: width: 200 | image_tag: alt: shop.name, loading: 'lazy' }}
        </div>
      {% endif %}

      <h1 class="password-title">
        {{ section.settings.heading }}
      </h1>

      <p class="password-text">
        {{ section.settings.subtext }}
      </p>

      {% form 'storefront_password' %}
        <div class="password-form">
          <input
            type="password"
            name="password"
            placeholder="Enter password"
            required
          >

          <button type="submit">Enter Store</button>
        </div>

        {% if form.errors %}
          <p class="password-error">
            {{ form.errors | default_errors }}
          </p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

<style>
  .password-page {
    text-align: center;
    padding: 80px 20px;
  }

  .password-logo img {
    margin-bottom: 20px;
  }

  .password-title {
    font-size: 32px;
    margin-bottom: 10px;
  }

  .password-text {
    margin-bottom: 30px;
  }

  .password-form {
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .password-form input {
    padding: 10px;
    border: 1px solid #ddd;
  }

  .password-form button {
    padding: 10px 20px;
    background: black;
    color: white;
    border: none;
    cursor: pointer;
  }

  .password-error {
    color: red;
    margin-top: 10px;
  }
</style>

{% schema %}
{
  "name": "Password Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening Soon"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Sub text",
      "default": "Be the first to know when we launch."
    }
  ]
}
{% endschema %}
